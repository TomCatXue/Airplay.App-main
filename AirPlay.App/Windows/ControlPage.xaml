<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AirPlay.App.Windows.ControlPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:AirPlay.App.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:AirPlay.App.Models"
    mc:Ignorable="d">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部：拖拽区 + 标题 + 设置 -->
        <Grid x:Name="PageTitleBar"
              Grid.Row="0"
              Height="44"
              Padding="16,0,8,0"
              Loaded="PageTitleBar_Loaded">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                <FontIcon FontSize="14" Glyph="&#xE7F4;" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Text="AirPlay" />
            </StackPanel>
            <Button
                Grid.Column="2"
                Width="32"
                Height="32"
                Padding="0"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                Click="SettingsButton_Click"
                CornerRadius="8"
                ToolTipService.ToolTip="设置">
                <FontIcon FontSize="14" Glyph="&#xE713;" />
            </Button>
        </Grid>

        <!-- 媒体卡：专辑封面 + 曲目信息 + 播放控制 -->
        <Border
            Grid.Row="1"
            Margin="16,0,16,12"
            Padding="14"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 封面 -->
                <Border
                    Width="56"
                    Height="56"
                    Background="{ThemeResource ControlStrongFillColorDefaultBrush}"
                    CornerRadius="8">
                    <Border CornerRadius="8">
                        <Grid>
                            <Image
                                Width="56"
                                Height="56"
                                Source="{x:Bind VM.Device.Cover, Mode=OneWay}"
                                Stretch="UniformToFill" />
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="24"
                                Glyph="&#xE7C4;"
                                x:Name="MirrorBadge"
                                Visibility="Collapsed" />
                        </Grid>
                    </Border>
                </Border>

                <!-- 曲目信息 -->
                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center" Spacing="3">
                    <TextBlock
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        Text="{x:Bind VM.Device.PlayingItemName, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind VM.Device.DisplaySubtitle, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind VM.Device.Album, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                </StackPanel>

                <!-- 播放控制 -->
                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="2">
                    <StackPanel.Resources>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Width" Value="36" />
                            <Setter Property="Height" Value="36" />
                            <Setter Property="CornerRadius" Value="18" />
                        </Style>
                    </StackPanel.Resources>
                    <Button Click="ControlButton_Click" IsEnabled="{x:Bind VM.Device.EnableControl, Mode=OneWay}" Tag="PrevItem" ToolTipService.ToolTip="上一首">
                        <FontIcon FontSize="14" Glyph="&#xF8AC;" />
                    </Button>
                    <Button Click="ControlButton_Click" IsEnabled="{x:Bind VM.Device.EnableControl, Mode=OneWay}" Tag="{x:Bind VM.Device.PlayPauseTag, Mode=OneWay}" ToolTipService.ToolTip="播放/暂停">
                        <FontIcon FontSize="16" Glyph="{x:Bind VM.Device.PlayPauseIcon, Mode=OneWay}" />
                    </Button>
                    <Button Click="ControlButton_Click" IsEnabled="{x:Bind VM.Device.EnableControl, Mode=OneWay}" Tag="NextItem" ToolTipService.ToolTip="下一首">
                        <FontIcon FontSize="14" Glyph="&#xF8AD;" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 音量条 -->
        <Border
            Grid.Row="2"
            Margin="16,0,16,12"
            Padding="14,8"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    Grid.Column="0"
                    Width="32"
                    Height="32"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="ControlButton_Click"
                    CornerRadius="16"
                    Tag="MuteToggle"
                    ToolTipService.ToolTip="静音">
                    <FontIcon FontSize="14" Glyph="&#xE74F;" />
                </Button>
                <Slider
                    Grid.Column="1"
                    Margin="12,0"
                    VerticalAlignment="Center"
                    IsEnabled="{x:Bind VM.Device.EnableControl, Mode=OneWay}"
                    Maximum="100"
                    Minimum="0"
                    Value="{x:Bind VM.Device.Volume, Mode=TwoWay}" />
                <TextBlock
                    Grid.Column="2"
                    MinWidth="28"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind VM.Device.VolumeText, Mode=OneWay}"
                    TextAlignment="Right" />
            </Grid>
        </Border>

        <!-- 设备列表 -->
        <Grid Grid.Row="3">
            <ListView
                x:Name="ListView"
                Margin="16,0,16,16"
                ItemsSource="{x:Bind VM.Devices}"
                SelectedItem="{x:Bind VM.Device, Mode=TwoWay}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,2" />
                        <Setter Property="CornerRadius" Value="10" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="model:Device">
                        <Grid Padding="12,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <FontIcon FontSize="18" Glyph="{x:Bind DeviceIcon}" />

                            <StackPanel Grid.Column="2" Spacing="2">
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    Text="{x:Bind Session.DeviceDisplayName}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind Session.DeviceModel}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                            </StackPanel>

                            <StackPanel
                                Grid.Column="3"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="12">
                                <FontIcon
                                    x:Name="VolumeIcon"
                                    x:Load="{x:Bind ShowVolumeIcon, Mode=OneWay}"
                                    FontSize="12"
                                    Glyph="&#xf61f;" />
                                <FontIcon
                                    x:Name="MirrorIcon"
                                    x:Load="{x:Bind ShowMirrorIcon, Mode=OneWay}"
                                    FontSize="12"
                                    Glyph="&#xE7C4;" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel
                x:Name="EmptyInfo"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                x:Load="{x:Bind VM.ShowNoDevice, Mode=OneWay}"
                Spacing="10">
                <FontIcon
                    FontSize="48"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xe70a;" />
                <StackPanel>
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="未连接设备" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="已连接的设备会显示在这里" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
